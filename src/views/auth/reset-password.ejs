<%- include('../partials/head', { title: 'Choose a new password', bodyClass: 'auth' }) %>
<header class="canopy"><div class="wrap bar"><a class="logo" href="/"><img src="/images/foodco-logo.svg" alt="FoodCo" width="196" height="64" /></a></div></header>
<main class="wrap auth-main">
  <div class="case"><div class="glass auth-card">
    <h1 class="plate">Choose a new password</h1>
    <p class="lede">Use at least 8 characters.</p>
    <% if (locals.error) { %><p class="alert" role="alert"><%= error %></p><% } %>
    <form method="post" action="/reset-password/<%= token %>" class="form" novalidate>
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />
      <label for="password">New password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required autofocus />
      <label for="confirm">Confirm new password</label>
      <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="8" required />
      <button class="btn" type="submit">Save password</button>
    </form>
  </div></div><div class="base" aria-hidden="true"></div>
</main>
<%- include('../partials/foot') %>
