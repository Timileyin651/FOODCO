<%- include('../partials/head', { title: 'Sign in', bodyClass: 'auth' }) %>
<header class="canopy"><div class="wrap bar"><a class="logo" href="/"><img src="/images/foodco-logo.svg" alt="FoodCo" width="196" height="64" /></a></div></header>
<main class="wrap auth-main">
  <div class="case"><div class="glass auth-card">
    <h1 class="plate">Staff sign in</h1>
    <p class="lede">Manage today's pastries, bakery and snacks.</p>
    <% if (locals.error) { %><p class="alert" role="alert"><%= error %></p><% } %>
    <% if (locals.notice) { %><p class="alert ok" role="status"><%= notice %></p><% } %>
    <form method="post" action="/login" class="form" novalidate>
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="username" required autofocus value="<%= locals.email || '' %>" />
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required />
      <button class="btn" type="submit">Sign in</button>
      <a class="link" href="/forgot-password">Forgot your password?</a>
    </form>
  </div></div><div class="base" aria-hidden="true"></div>
</main>
<%- include('../partials/foot') %>
