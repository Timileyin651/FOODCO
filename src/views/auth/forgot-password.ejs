<%- include('../partials/head', { title: 'Reset password', bodyClass: 'auth' }) %>
<header class="canopy"><div class="wrap bar"><a class="logo" href="/"><img src="/images/foodco-logo.svg" alt="FoodCo" width="196" height="64" /></a></div></header>
<main class="wrap auth-main">
  <div class="case"><div class="glass auth-card">
    <h1 class="plate">Reset your password</h1>
    <p class="lede">Enter your work email and we'll send you a reset link.</p>
    <% if (locals.error) { %><p class="alert" role="alert"><%= error %></p><% } %>
    <% if (locals.notice) { %><p class="alert ok" role="status"><%= notice %></p><% } %>
    <form method="post" action="/forgot-password" class="form" novalidate>
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="username" required autofocus />
      <button class="btn" type="submit">Send reset link</button>
      <a class="link" href="/login">Back to sign in</a>
    </form>
  </div></div><div class="base" aria-hidden="true"></div>
</main>
<%- include('../partials/foot') %>
