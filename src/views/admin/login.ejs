<%- include('../partials/head', { title: 'Log in' }) %>
<%- include('../partials/header') %>

<main class="wrap auth-main">
  <div class="case">
    <div class="glass auth-card">
      <h1 class="plate">Log in</h1>
      <p class="lede">Sign in to manage the FoodCo case.</p>

      <%- include('../partials/flash') %>

      <% if (locals.formError) { %>
      <p class="alert err" role="alert"><%= formError %></p>
      <% } %>

      <form class="form" method="post" action="/login" novalidate>
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />

        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="username"
          required
          value="<%= locals.values && values.email ? values.email : '' %>"
          <% if (locals.errors && errors.email) { %>aria-invalid="true" aria-describedby="email-error"<% } %>
        />
        <% if (locals.errors && errors.email) { %>
        <p class="field-err" id="email-error"><%= errors.email %></p>
        <% } %>

        <label for="password">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
          <% if (locals.errors && errors.password) { %>aria-invalid="true" aria-describedby="password-error"<% } %>
        />
        <% if (locals.errors && errors.password) { %>
        <p class="field-err" id="password-error"><%= errors.password %></p>
        <% } %>

        <button class="btn btn-amber" type="submit">Log in</button>
      </form>

      <a class="link" href="/forgot-password">Forgot your password?</a>
    </div>
  </div>
  <div class="base" aria-hidden="true"></div>
</main>

<%- include('../partials/foot') %>
