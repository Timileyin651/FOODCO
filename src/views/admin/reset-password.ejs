<%- include('../partials/head', { title: 'Reset password' }) %>
<%- include('../partials/header') %>

<main class="wrap auth-main">
  <div class="case">
    <div class="glass auth-card">
      <h1 class="plate">Reset password</h1>

      <% if (locals.tokenError) { %>
      <p class="alert err" role="alert"><%= tokenError %></p>
      <a class="link" href="/forgot-password">Request a new reset link</a>
      <% } else { %>
      <p class="lede">Choose a new password. It must be at least 8 characters.</p>

      <form
        class="form"
        method="post"
        action="/reset-password/<%= locals.token || '' %>"
        novalidate
      >
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />

        <label for="password">New password</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
          <% if (locals.errors && errors.password) { %>aria-invalid="true" aria-describedby="password-error"<% } %>
        />
        <% if (locals.errors && errors.password) { %>
        <p class="field-err" id="password-error"><%= errors.password %></p>
        <% } %>

        <label for="confirm">Confirm new password</label>
        <input
          id="confirm"
          name="confirm"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
          <% if (locals.errors && errors.confirm) { %>aria-invalid="true" aria-describedby="confirm-error"<% } %>
        />
        <% if (locals.errors && errors.confirm) { %>
        <p class="field-err" id="confirm-error"><%= errors.confirm %></p>
        <% } %>

        <button class="btn btn-amber" type="submit">Save password</button>
      </form>
      <% } %>
    </div>
  </div>
  <div class="base" aria-hidden="true"></div>
</main>

<%- include('../partials/foot') %>
