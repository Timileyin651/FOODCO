<%- include('../partials/head', { title: 'Dashboard' }) %>
<%- include('../partials/header') %>

<div class="wrap shell">
  <%- include('../partials/sidebar', { active: '/dashboard' }) %>

  <main class="panel">
    <div class="case">
      <div class="glass">
        <div class="panel-head">
          <h1 class="plate"><%= locals.branch ? branch.name : 'Overview' %></h1>
        </div>

        <%- include('../partials/flash') %>

        <p class="lede">
          Welcome back<%= locals.user ? ', ' + user.name : '' %>.<%= locals.branch ? ' Managing the ' + branch.name + ' case' : '' %>. Pick a
          section on the left to manage what is on the shelves.
        </p>

        <ul class="grid stats">
          <li class="card">
            <a href="/dashboard/<%= branch.slug %>/bakery">
              <svg class="ico big" aria-hidden="true"><use href="#i-loaf"></use></svg>
              <h2>Bakery</h2>
              <p class="count"><%= locals.counts ? counts.bakery : 0 %></p>
              <p class="hint">items in the case</p>
            </a>
          </li>
          <li class="card">
            <a href="/dashboard/<%= branch.slug %>/pastries">
              <svg class="ico big" aria-hidden="true"><use href="#i-pastry"></use></svg>
              <h2>Pastries</h2>
              <p class="count"><%= locals.counts ? counts.pastries : 0 %></p>
              <p class="hint">items in the case</p>
            </a>
          </li>
          <li class="card">
            <a href="/dashboard/<%= branch.slug %>/snacks">
              <svg class="ico big" aria-hidden="true"><use href="#i-snack"></use></svg>
              <h2>Snacks</h2>
              <p class="count"><%= locals.counts ? counts.snacks : 0 %></p>
              <p class="hint">items in the case</p>
            </a>
          </li>
          <li class="card">
            <a href="/dashboard/<%= branch.slug %>/audit">
              <svg class="ico big" aria-hidden="true"><use href="#i-clipboard"></use></svg>
              <h2>Audit</h2>
              <p class="count">&mdash;</p>
              <p class="hint">every change, newest first</p>
            </a>
          </li>
        </ul>

        <h2 class="plate sub">Latest activity</h2>
        <% if (locals.recent && recent.length) { %>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th scope="col">When</th>
                <th scope="col">User</th>
                <th scope="col">Summary</th>
              </tr>
            </thead>
            <tbody>
              <% recent.forEach(function (entry) { %>
              <tr>
                <td class="nowrap"><%= new Date(entry.createdAt).toLocaleString() %></td>
                <td><%= entry.userLabel %></td>
                <td><%= entry.summary %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <p class="empty">Nothing has been recorded yet.</p>
        <% } %>
      </div>
    </div>
    <div class="base" aria-hidden="true"></div>
  </main>
</div>

<%- include('../partials/foot') %>
