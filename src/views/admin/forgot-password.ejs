<%- include('../partials/head', { title: 'Forgot password' }) %>
<%- include('../partials/header') %>

<main class="wrap auth-main">
  <div class="case">
    <div class="glass auth-card">
      <h1 class="plate">Forgot password</h1>

      <% if (locals.sent) { %>
      <p class="lede" role="status"><%= locals.message || 'If that email is in our records, a reset link is on its way.' %></p>
      <a class="link" href="/login">Back to log in</a>
      <% } else { %>
      <p class="lede">
        Enter the email you sign in with and we&rsquo;ll send a link to choose a
        new password. The link expires after one hour.
      </p>

      <form class="form" method="post" action="/forgot-password" novalidate>
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />

        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="username"
          required
          value="<%= locals.values && values.email ? values.email : '' %>"
          <% if (locals.errors && errors.email) { %>aria-invalid="true" aria-describedby="email-error"<% } %>
        />
        <% if (locals.errors && errors.email) { %>
        <p class="field-err" id="email-error"><%= errors.email %></p>
        <% } %>

        <button class="btn btn-amber" type="submit">Send reset link</button>
      </form>

      <a class="link" href="/login">Back to log in</a>
      <% } %>
    </div>
  </div>
  <div class="base" aria-hidden="true"></div>
</main>

<%- include('../partials/foot') %>
