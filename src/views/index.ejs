<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="theme-color" content="#0a6925" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FoodCo | Fresh from the case</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script>
      document.documentElement.classList.add("js");
    </script>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <% /* FoodCo bakery display. The shelves are fed from the same Bakery,
    Pastry and Snack collections the admin edits, so this page always shows
    the current case. Product images live in public/images/products/*. */ %>

    <header class="canopy">
      <div class="wrap bar">
        <a class="logo" href="#top" aria-label="FoodCo home"
          ><img src="/images/foodco-logo.svg" alt="FoodCo" width="196" height="64"
        /></a>
        <div class="bar-actions">
          <ul class="legend" aria-label="Availability key">
            <li><i class="dot"></i>Available</li>
            <li><i class="dot out"></i>Not available</li>
          </ul>
          <% if (locals.branches && branches.length) { %>
          <label class="sr" for="city-switch">Choose your branch</label>
          <select id="city-switch" class="city-switch">
            <% branches.forEach(function (entry) { %>
            <option value="<%= entry.slug %>" <%= locals.branch && branch.slug === entry.slug ? 'selected' : '' %>><%= entry.name %></option>
            <% }) %>
          </select>
          <% } %>
          <a class="staff-link" href="<%= locals.user ? '/dashboard' : '/login' %>"
            ><%= locals.user ? 'Dashboard' : 'Staff log in' %></a
          >
        </div>
      </div>
    </header>

    <div id="top" class="wrap intro">
      <% if (!locals.branch) { %>
      <h1>Where are you?</h1>
      <p>
        FoodCo has five branches. Pick yours to see what is fresh in the case
        today.
      </p>
      <% } else { %>
      <h1><%= branch.name %></h1>
      <p>
        Everything here is baked today and kept warm at our <%= branch.name %>
        <% if (branch.location) { %>shop (<%= branch.location %>)<% } %>.
        Dimmed items are sold out until the next batch.
      </p>
      <% } %>
    </div>
    <main class="wrap">
      <div class="case">
        <div class="glass">
          <% if (!locals.branch) { %>
          <ul class="grid cities">
            <% (locals.branches || []).forEach(function (entry) { %>
            <li class="card">
              <a href="/?branch=<%= entry.slug %>">
                <h2><%= entry.name %></h2>
                <% if (entry.location) { %>
                <p class="hint"><%= entry.location %></p>
                <% } %>
              </a>
            </li>
            <% }) %>
          </ul>
          <% if (!(locals.branches || []).length) { %>
          <p class="empty-shelf">No branches are open yet.</p>
          <% } %>
          <% } else { %>
          <% (locals.shelves || []).forEach(function (shelf) { %>
          <section class="shelf" aria-labelledby="<%= shelf.id %>">
            <h2 class="plate reveal" id="<%= shelf.id %>"><%= shelf.heading %></h2>

            <% if (!shelf.items.length) { %>
            <p class="empty-shelf">
              Nothing on this shelf right now. Please check back for the next
              batch.
            </p>
            <% } else { %>
            <ul class="grid">
              <% shelf.items.forEach(function (item, index) {
                   var palette = shelf.palettes[index % shelf.palettes.length];
                   var src = locals.imgSrc ? imgSrc(item.image) : '';
                   var isOut = item.status === 'out';
              %>
              <li
                class="card reveal"
                style="--a: <%= palette.a %>; --b: <%= palette.b %><% if (palette.c) { %>; --c: <%= palette.c %><% } %>"
                data-status="<%= item.status %>"
              >
                <div class="art">
                  <% if (src) { %>
                  <img
                    src="<%= src %>"
                    alt="<%= item.name %>"
                    class="product-image"
                    loading="lazy"
                  />
                  <% } %> <% if (isOut) { %>
                  <span class="badge" aria-hidden="true">Not available</span>
                  <% } %>
                </div>
                <h3><%= item.name %></h3>
                <p class="status">
                  <i class="dot<%= isOut ? ' out' : '' %>"></i>
                  <%= isOut ? 'Not available' : 'Available' %>
                </p>
              </li>
              <% }) %>
            </ul>
            <% } %>

            <div class="rail"></div>
          </section>
          <% }) %>
          <% } %>
        </div>
      </div>
      <div class="base" aria-hidden="true"></div>
    </main>

    <footer>
      <p>&copy; FoodCo. Availability changes as each batch sells out.</p>
    </footer>

    <script src="/js/script.js" defer></script>
    <script>
      (function () {
        var picker = document.getElementById('city-switch');
        if (picker) {
          picker.addEventListener('change', function () {
            window.location.href = '/?branch=' + picker.value;
          });
        }
      })();
    </script>
  </body>
</html>
