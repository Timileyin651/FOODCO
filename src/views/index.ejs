<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="theme-color" content="#0a6925" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FoodCo | Fresh from the case</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script>
      document.documentElement.classList.add("js");
    </script>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <% /* FoodCo bakery display template. Product images are served from
    public/images/products/*.svg */ %>

    <header class="canopy">
      <div class="wrap bar">
        <a class="logo" href="#top" aria-label="FoodCo home"
          ><img src="/images/foodco-logo.svg" alt="FoodCo" width="196" height="64"
        /></a>
        <ul class="legend" aria-label="Availability key">
          <li><i class="dot"></i>Available</li>
          <li><i class="dot out"></i>Not available</li>
        </ul>
      </div>
    </header>

    <div id="top" class="wrap intro">
      <h1>Fresh from the case</h1>
      <p>
        Everything here is baked today and kept warm. Dimmed items are sold out
        until the next batch.
      </p>
    </div>
    <main class="wrap">
      <div class="case">
        <div class="glass">
          <!-- ===================== BAKERY ===================== -->
          <section class="shelf" aria-labelledby="h-bakery">
            <h2 class="plate reveal" id="h-bakery">Bakery</h2>
            <ul class="grid">
              <li
                class="card reveal"
                style="--a: #d9a15a; --b: #9c5f26"
                data-status="in"
              >
                <div class="art">
                  <img
                    src="/images/products/country-loaf.svg"
                    alt="Country loaf"
                    class="product-image"
                    loading="lazy"
                  />
                </div>
                <h3>Country loaf</h3>
                <p class="status"><i class="dot"></i>Available</p>
              </li>

              <li
                class="card reveal"
                style="--a: #a8733f; --b: #6a3f1c"
                data-status="in"
              >
                <div class="art">
                  <img
                    src="/images/products/whole-wheat-loaf.svg"
                    alt="Whole wheat loaf"
                    class="product-image"
                    loading="lazy"
                  />
                </div>
                <h3>Whole wheat loaf</h3>
                <p class="status"><i class="dot"></i>Available</p>
              </li>

              <li
                class="card reveal"
                style="--a: #e3b066; --b: #a8692b"
                data-status="out"
              >
                <div class="art">
                  <img
                    src="/images/products/baguette.svg"
                    alt="Baguette"
                    class="product-image"
                    loading="lazy"
                  />
                  <span class="badge" aria-hidden="true">Not available</span>
                </div>
                <h3>Baguette</h3>
                <p class="status"><i class="dot out"></i>Not available</p>
              </li>

              <li
                class="card reveal"
                style="--a: #d58a3c; --b: #9a5a1f"
                data-status="in"
              >
                <div class="art">
                  <img
                    src="/images/products/sesame-bun.svg"
                    alt="Sesame bun"
                    class="product-image"
                    loading="lazy"
                  />
                </div>
                <h3>Sesame bun</h3>
                <p class="status"><i class="dot"></i>Available</p>
              </li>
            </ul>
            <div class="rail"></div>
          </section>

          <!-- ===================== PASTRIES ===================== -->
          <section class="shelf" aria-labelledby="h-pastries">
            <h2 class="plate reveal" id="h-pastries">Pastries</h2>
            <ul class="grid">
              <li
                class="card reveal"
                style="--a: #e9a845; --b: #b06a1c"
                data-status="in"
              >
                <div class="art">
                  <img
                    src="/images/products/butter-croissant.svg"
                    alt="Butter croissant"
                    class="product-image"
                    loading="lazy"
                  />
                </div>
                <h3>Butter croissant</h3>
                <p class="status"><i class="dot"></i>Available</p>
              </li>

              <li
                class="card reveal"
                style="--a: #d9a15a; --b: #f08cb4"
                data-status="out"
              >
                <div class="art">
                  <img
                    src="/images/products/glazed-donut.svg"
                    alt="Glazed donut"
                    class="product-image"
                    loading="lazy"
                  />
                  <span class="badge" aria-hidden="true">Not available</span>
                </div>
                <h3>Glazed donut</h3>
                <p class="status"><i class="dot out"></i>Not available</p>
              </li>

              <li
                class="card reveal"
                style="--a: #8c6f9e; --b: #e7cfa6; --c: #3b3f8f"
                data-status="in"
              >
                <div class="art">
                  <img
                    src="/images/products/blueberry-muffin.svg"
                    alt="Blueberry muffin"
                    class="product-image"
                    loading="lazy"
                  />
                </div>
                <h3>Blueberry muffin</h3>
                <p class="status"><i class="dot"></i>Available</p>
              </li>

              <li
                class="card reveal"
                style="--a: #e0a24f; --b: #f08a3a; --c: #fff0c9"
                data-status="in"
              >
                <div class="art">
                  <img
                    src="/images/products/apricot-danish.svg"
                    alt="Apricot danish"
                    class="product-image"
                    loading="lazy"
                  />
                </div>
                <h3>Apricot danish</h3>
                <p class="status"><i class="dot"></i>Available</p>
              </li>
            </ul>
            <div class="rail"></div>
          </section>

          <!-- ===================== SNACKS ===================== -->
          <section class="shelf" aria-labelledby="h-snacks">
            <h2 class="plate reveal" id="h-snacks">Snacks</h2>
            <ul class="grid">
              <li
                class="card reveal"
                style="--a: #d9a15a; --b: #a8662a; --c: #8c4a2f"
                data-status="in"
              >
                <div class="art">
                  <img
                    src="/images/products/sausage-roll.svg"
                    alt="Sausage roll"
                    class="product-image"
                    loading="lazy"
                  />
                </div>
                <h3>Sausage roll</h3>
                <p class="status"><i class="dot"></i>Available</p>
              </li>

              <li
                class="card reveal"
                style="--a: #d9983f; --b: #9d5d1b"
                data-status="in"
              >
                <div class="art">
                  <img
                    src="/images/products/meat-pie.svg"
                    alt="Meat pie"
                    class="product-image"
                    loading="lazy"
                  />
                </div>
                <h3>Meat pie</h3>
                <p class="status"><i class="dot"></i>Available</p>
              </li>

              <li
                class="card reveal"
                style="--a: #d6a04a; --b: #8f5a1c"
                data-status="out"
              >
                <div class="art">
                  <img
                    src="/images/products/samosa.svg"
                    alt="Samosa"
                    class="product-image"
                    loading="lazy"
                  />
                  <span class="badge" aria-hidden="true">Not available</span>
                </div>
                <h3>Samosa</h3>
                <p class="status"><i class="dot out"></i>Not available</p>
              </li>

              <li
                class="card reveal"
                style="--a: #d9964a; --b: #f6d9a0"
                data-status="in"
              >
                <div class="art">
                  <img
                    src="/images/products/puff-puff.svg"
                    alt="Puff-puff"
                    class="product-image"
                    loading="lazy"
                  />
                </div>
                <h3>Puff-puff</h3>
                <p class="status"><i class="dot"></i>Available</p>
              </li>
            </ul>
            <div class="rail"></div>
          </section>
        </div>
      </div>
      <div class="base" aria-hidden="true"></div>
    </main>

    <footer>
      <p>&copy; FoodCo. Availability changes as each batch sells out.</p>
    </footer>

    <script src="/js/script.js" defer></script>
  </body>
</html>
