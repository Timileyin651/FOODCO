# Copy to .env (project root) or src/.env and fill in real values.
# Never commit the real .env file.

# --- Server ---
PORT=4000
HOST=localhost
NODE_ENV=development

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/foodco

# --- Auth / sessions ---
# Signs the existing JWT cookie (existing backend).
JWT_SECRET=replace-with-a-long-random-string
# Signs the session cookie used by the dashboard. Falls back to JWT_SECRET.
SESSION_SECRET=replace-with-a-different-long-random-string

# --- Seed script (npm run seed) ---
# Superadmin: sees every branch
ADMIN_EMAIL=admin@foodco.com
ADMIN_PASSWORD=replace-with-a-strong-password
# One admin per branch (abuja.admin@foodco.com, lagos.admin@foodco.com, ...).
# Each can only open its own dashboard. Optional per-branch overrides:
# ABUJA_ADMIN_PASSWORD=... LAGOS_ADMIN_PASSWORD=... OYO_ADMIN_PASSWORD=...
# BENIN_ADMIN_PASSWORD=... SOKOTO_ADMIN_PASSWORD=...
BRANCH_ADMIN_PASSWORD=replace-with-another-strong-password

# --- Mail (optional) ---
# Password reset emails. When SMTP_HOST is empty the reset link is logged to
# the console instead (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FoodCo <no-reply@foodco.test>"
